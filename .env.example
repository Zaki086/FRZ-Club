# Postgres (docker compose maps the container to port 5442)
DATABASE_URL="postgresql://champions:champions@localhost:5442/champions?connection_limit=25&pool_timeout=30"
TEST_DATABASE_URL="postgresql://champions:champions@localhost:5442/champions_test?connection_limit=25&pool_timeout=30"
# Secret used to sign member-card QR payloads (MB-14) and Test Gateway callbacks (PY-7)
APP_SECRET="change-me-to-a-long-random-string"
APP_URL="http://localhost:3200"
# Optional: SMTP. Without it, emails go to the email_outbox table and the console (never crash).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="The Champions Club <no-reply@championsclub.test>"
# Optional: Razorpay TEST keys. Without them, the built-in Test Gateway is used.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
