# Postgres (docker compose maps the container to port 5442)
DATABASE_URL="postgresql://champions:champions@localhost:5442/champions?connection_limit=25&pool_timeout=30"
TEST_DATABASE_URL="postgresql://champions:champions@localhost:5442/champions_test?connection_limit=25&pool_timeout=30"
# Secret used to sign member-card QR payloads (MB-14) and sessions. Production refuses to start with this
# placeholder or anything shorter than 32 characters — generate one: openssl rand -base64 48
APP_SECRET="change-me-to-a-long-random-string"
APP_URL="http://localhost:3200"
# Optional: SMTP. Email is offered only when SMTP_HOST + SMTP_FROM are set AND the Owner has sent a test email
# from Settings; otherwise nothing is promised by email (in-app notifications only).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# Optional: Razorpay LIVE keys (rzp_live_…) + the webhook secret. Without all three, online payment is not offered
# anywhere (members pay at the desk / at pickup / on delivery). Test keys never enable it.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Backups (nightly 02:30 IST, kept 14 days, Settings → Backups). With Docker, dump inside the Postgres container so
# pg_dump matches the server version; leave empty to use the host's pg_dump.
BACKUP_PG_CONTAINER="champions-postgres"
BACKUP_DIR="backups"
# Sample data only (`npm run seed:demo`): passwords for the sample staff and member logins (8+ characters).
SEED_STAFF_PASSWORD=""
SEED_MEMBER_PASSWORD=""
# Set to 1 to allow `npm run demo:reset` to wipe a SAMPLE_DATA database and rebuild it.
ALLOW_DEMO_RESET=""
# v3 §6.3 / v4 §4.2 Web Push: on only when APP_URL is https:// and both keys are set. Generate the pair once with
# `npm run vapid:generate`; keep the private key secret (new keys make every device turn push on again).
# VAPID_SUBJECT is the push services' contact: mailto: the club's email (falls back to the club email in Settings).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
# v4 §5.1 WhatsApp Cloud API (Meta, paid per message). All six are needed; then in Settings → WhatsApp: check the
# token, map the approved templates (docs/whatsapp-templates.md) and send a test message. Without them, WhatsApp
# messages wait in "Messages to send" for the desk. Webhook callback URL: <APP_URL>/api/whatsapp/webhook.
# Permanent System User access token (Business Settings → System users), with whatsapp_business_messaging and
# whatsapp_business_management permissions.
WHATSAPP_ACCESS_TOKEN=""
# The club number's Phone number ID and the WhatsApp Business Account ID (WhatsApp → API Setup in the Meta app).
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# App secret (App settings → Basic): verifies the webhook's X-Hub-Signature-256.
WHATSAPP_APP_SECRET=""
# Any long random string; enter the same value as the webhook "Verify token" in the Meta app dashboard.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# Graph API version shown in Meta's dashboard (e.g. "v23.0"); there is no default in the code.
WHATSAPP_GRAPH_API_VERSION=""

# HTTPS on the club's own port (scripts/https.mjs, PM2 "champions-https"): a Let's Encrypt certificate for these
# names, obtained with the DNS-01 challenge that sslip.io / nip.io delegate to the IP inside the name (this server
# answers it on HTTPS_DNS_BIND:53 while the certificate is issued or renewed). The first name is the public address;
# set APP_URL to https://<first name>:<HTTPS_PORT>. ACME_EMAIL is optional.
HTTPS_HOSTS=""
HTTPS_PORT="3443"
HTTPS_DNS_BIND=""
ACME_EMAIL=""
