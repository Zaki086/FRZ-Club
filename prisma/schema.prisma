  OWNER
  MANAGER
  FRONT_DESK
  SHOP_STAFF
  BAR_STAFF
  ACCOUNTANT
  MEMBER
  KITCHEN
}

enum PlanCode {
  GOLD
  SILVER
  JUNIOR
}

enum MembershipStatus {
  PENDING_PAYMENT
  SCHEDULED
  ACTIVE
  EXPIRED
  CHANGED
  CANCELLED
}

enum Sport {
  TENNIS
  CRICKET
  PADEL
  BADMINTON
}

enum ReservationKind {
  REGULAR
  SOCIAL
  MAINTENANCE
}

enum ReservationStatus {
  ACTIVE
  CANCELLED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  CANCELLED_BY_CLUB
}

enum BookingChannel {
  FRONT_DESK
  PHONE
  MESSAGE
  WALK_IN
  ONLINE_MEMBER
  ONLINE_TRIAL
}

enum SocialStatus {
