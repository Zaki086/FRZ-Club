  SETTLED
  CARRIED
  VOID
}

enum TabLineStatus {
  NEW
  PREPARING
  READY
  SERVED
  VOID
}

enum BillSource {
  BOOKING
  SOCIAL_JOIN
  COUNTER_SALE
  SHOP_ORDER
  SERVICE_TICKET
  BAR_TAB
  MEMBERSHIP
  INVOICE
}

enum BillStatus {
  UNPAID
  PARTIAL
  PAID
  VOID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentType {
