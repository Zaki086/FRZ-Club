// ───────────────────────────── identity & auth ─────────────────────────────

model User {
  id                String    @id @default(cuid())
  name              String
  phone             String    @unique
  email             String?   @unique
  passwordHash      String?   @map("password_hash")
  role              Role
  active            Boolean   @default(true)
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(3)
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(3)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(3)
  /// v3 §6.3 member preferences (in-app can't be turned off) and §6.4 WK-2 first credentials.
  notifyPush          Boolean   @default(true) @map("notify_push")
  notifyEmail         Boolean   @default(true) @map("notify_email")
  notifyWhatsapp      Boolean   @default(true) @map("notify_whatsapp")
  credentialsIssuedAt DateTime? @map("credentials_issued_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(dbgenerated("app_now()")) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions      Session[]
  member        Member?
  employee      Employee?
  notifications Notification[]
  setTokens     PasswordSetToken[]

  @@map("users")
}

model Session {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  // v3 §6.1 sliding sessions: MEMBER | STAFF | KIOSK decide the idle and absolute windows.
  kind              String    @default("STAFF")
  lastSeenAt        DateTime? @map("last_seen_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime? @map("absolute_expires_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(dbgenerated("app_now()")) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id])

  @@map("sessions")
}

model PasswordSetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  purpose   String    @default("SET") // SET (new account) | RESET (forgotten password)
  createdBy String?   @map("created_by")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(dbgenerated("app_now()")) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id])

  @@map("password_set_tokens")
}

// ───────────────────────────── members & memberships ─────────────────────────────

model Member {
  id                    String    @id @default(cuid())
  userId                String?   @unique @map("user_id")
  memberCode            String    @unique @map("member_code")
  name                  String
  phone                 String    @unique
  email                 String?
  dob                   DateTime  @db.Date
  photoUrl              String?   @map("photo_url")
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  nextPlanId            String?   @map("next_plan_id")
  nextPlanMonths        Int?      @map("next_plan_months")
  leadId                String?   @map("lead_id")
  consentAt             DateTime? @map("consent_at") @db.Timestamptz(3)
  // Completion pass P1: guardian of a Junior / under-18 member (linked when the guardian is a member too).
  guardianName          String?   @map("guardian_name")
  guardianPhone         String?   @map("guardian_phone")
  guardianMemberId      String?   @map("guardian_member_id")
  // DPDP erasure: personal data replaced, transactions kept.
  anonymisedAt          DateTime? @map("anonymised_at") @db.Timestamptz(3)
  createdBy             String?   @map("created_by")
  createdAt             DateTime  @default(dbgenerated("app_now()")) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User?     @relation(fields: [userId], references: [id])
  nextPlan              Plan?     @relation("NextPlan", fields: [nextPlanId], references: [id])

  memberships Membership[]

  @@map("members")
}

model Guest {
  id           String    @id @default(cuid())
  name         String
  phone        String?   @unique
  email        String?
  idVerifiedAt DateTime? @map("id_verified_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(dbgenerated("app_now()")) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("guests")
}

model Plan {
  id                 String         @id @default(cuid())
  code               PlanCode       @unique
  name               String
  description        String         @default("")
  price1m            Int            @map("price_1m")
  price3m            Int            @map("price_3m")
  price12m           Int            @map("price_12m")
  socialFee          Int            @map("social_fee")
  shopDiscountPct    Int            @map("shop_discount_pct")
  barDiscountPct     Int            @map("bar_discount_pct")
  advanceBookingDays Int            @map("advance_booking_days")
  alcoholAllowed     Boolean        @map("alcohol_allowed")
  rank               Int
  active             Boolean        @default(true)
  createdAt          DateTime       @default(dbgenerated("app_now()")) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  courtFees          PlanCourtFee[]
  memberships        Membership[]
  nextFor            Member[]       @relation("NextPlan")

  @@map("plans")
}

model PlanCourtFee {
  id        String   @id @default(cuid())
  planId    String   @map("plan_id")
  sport     Sport
  fee       Int
  createdAt DateTime @default(dbgenerated("app_now()")) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  plan      Plan     @relation(fields: [planId], references: [id])

  @@unique([planId, sport])
  @@map("plan_court_fees")
}

model Membership {
  id             String           @id @default(cuid())
  memberId       String           @map("member_id")
  planId         String           @map("plan_id")
  startDate      DateTime         @map("start_date") @db.Date
  endDate        DateTime         @map("end_date") @db.Date
  durationMonths Int              @map("duration_months")
  status         MembershipStatus
  price          Int
  creditApplied  Int              @default(0) @map("credit_applied")
  billId         String?          @unique @map("bill_id")
  changedFromId  String?          @map("changed_from_id")
  kind           String           @default("NEW") // NEW | RENEWAL | UPGRADE | DOWNGRADE_RENEWAL
  cancelReason   String?          @map("cancel_reason")
  createdBy      String?          @map("created_by")
  createdAt      DateTime         @default(dbgenerated("app_now()")) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  member         Member           @relation(fields: [memberId], references: [id])
  plan           Plan             @relation(fields: [planId], references: [id])

  @@index([memberId])
  @@map("memberships")
}

model MembershipReminder {
  id           String   @id @default(cuid())
  membershipId String   @map("membership_id")
  reminderType String   @map("reminder_type") // D7 | D1 | EXPIRED
  sentAt       DateTime @map("sent_at") @db.Timestamptz(3)
  createdAt    DateTime @default(dbgenerated("app_now()")) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([membershipId, reminderType])
  @@map("membership_reminders")
}

model Visit {
  id           String    @id @default(cuid())
  memberId     String?   @map("member_id")
  guestId      String?   @map("guest_id")
  bookingId    String?   @map("booking_id")
  checkedInAt  DateTime  @map("checked_in_at") @db.Timestamptz(3)
  checkedOutAt DateTime? @map("checked_out_at") @db.Timestamptz(3)
  byUserId     String?   @map("by_user_id")
  createdAt    DateTime  @default(dbgenerated("app_now()")) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([memberId])
  @@map("visits")
}

// ───────────────────────────── courts & bookings ─────────────────────────────

model Court {
  id           String             @id @default(cuid())
  name         String             @unique
  sport        Sport
  maxPlayers   Int                @map("max_players")
  sortOrder    Int                @default(0) @map("sort_order")
  active       Boolean            @default(true)
  archivedAt   DateTime?          @map("archived_at") @db.Timestamptz(3)
  createdAt    DateTime           @default(dbgenerated("app_now()")) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  reservations CourtReservation[]

  @@map("courts")
}

model CourtReservation {
  id          String              @id @default(cuid())
  courtId     String              @map("court_id")
  startAt     DateTime            @map("start_at") @db.Timestamptz(3)
  endAt       DateTime            @map("end_at") @db.Timestamptz(3)
  // period tstzrange GENERATED ALWAYS AS (tstzrange(start_at, end_at, '[)')) STORED — raw SQL, BK-1
  kind        ReservationKind
  status      ReservationStatus   @default(ACTIVE)
  note        String?
  closureId   String?             @map("closure_id")
  createdBy   String?             @map("created_by")
  createdAt   DateTime            @default(dbgenerated("app_now()")) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  court       Court               @relation(fields: [courtId], references: [id])
  booking     Booking?
  socialCourt SocialSessionCourt?

  @@index([courtId, startAt])
  @@map("court_reservations")
}

model Booking {
  id              String           @id @default(cuid())
  bookingCode     String           @unique @map("booking_code")
  reservationId   String           @unique @map("reservation_id")
  primaryMemberId String?          @map("primary_member_id")
  primaryGuestId  String?          @map("primary_guest_id")
  channel         BookingChannel
  status          BookingStatus    @default(CONFIRMED)
  billId          String?          @unique @map("bill_id")
  note            String?
  cancelledAt     DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy     String?          @map("cancelled_by")
  cancelReason    String?          @map("cancel_reason")
  createdBy       String?          @map("created_by")
  createdAt       DateTime         @default(dbgenerated("app_now()")) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  reservation     CourtReservation @relation(fields: [reservationId], references: [id])
  players         BookingPlayer[]

  @@map("bookings")
}

model BookingPlayer {
  id           String    @id @default(cuid())
  bookingId    String    @map("booking_id")
  memberId     String?   @map("member_id")
  guestId      String?   @map("guest_id")
  feeSnapshot  Int       @map("fee_snapshot")
  tierSnapshot String    @map("tier_snapshot")
  billLineId   String?   @unique @map("bill_line_id")
  checkedInAt  DateTime? @map("checked_in_at") @db.Timestamptz(3)
  removedAt    DateTime? @map("removed_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(dbgenerated("app_now()")) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  booking      Booking   @relation(fields: [bookingId], references: [id])

  @@index([memberId])
  @@index([guestId])
  @@map("booking_players")
}

model SocialSession {
  id               String               @id @default(cuid())
  title            String
  seriesId         String?              @map("series_id")
  date             DateTime             @db.Date
  startAt          DateTime             @map("start_at") @db.Timestamptz(3)
  endAt            DateTime             @map("end_at") @db.Timestamptz(3)
  capacityPerCourt Int                  @map("capacity_per_court")
  status           SocialStatus         @default(SCHEDULED)
  createdBy        String?              @map("created_by")
  createdAt        DateTime             @default(dbgenerated("app_now()")) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  courts           SocialSessionCourt[]
  participants     SocialParticipant[]

  @@map("social_sessions")
}

model SocialSessionCourt {
  id            String           @id @default(cuid())
  sessionId     String           @map("session_id")
  courtId       String           @map("court_id")
  reservationId String           @unique @map("reservation_id")
  createdAt     DateTime         @default(dbgenerated("app_now()")) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  session       SocialSession    @relation(fields: [sessionId], references: [id])
  reservation   CourtReservation @relation(fields: [reservationId], references: [id])

  @@map("social_session_courts")
}

model SocialParticipant {
  id           String            @id @default(cuid())
  sessionId    String            @map("session_id")
  memberId     String?           @map("member_id")
  guestId      String?           @map("guest_id")
  feeSnapshot  Int               @map("fee_snapshot")
  tierSnapshot String            @map("tier_snapshot")
  status       ParticipantStatus @default(JOINED)
  billId       String?           @unique @map("bill_id")
  channel      BookingChannel
  checkedInAt  DateTime?         @map("checked_in_at") @db.Timestamptz(3)
  leftAt       DateTime?         @map("left_at") @db.Timestamptz(3)
  createdBy    String?           @map("created_by")
  createdAt    DateTime          @default(dbgenerated("app_now()")) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  session      SocialSession     @relation(fields: [sessionId], references: [id])

  @@index([memberId])
  @@map("social_participants")
}

// ───────────────────────────── shop & inventory ─────────────────────────────

model Product {
  id          String           @id @default(cuid())
  name        String
  brand       String           @default("")
  category    ProductCategory
  description String           @default("")
  imageUrl    String?          @map("image_url")
  trackStock  Boolean          @default(true) @map("track_stock")
  isRestring  Boolean          @default(false) @map("is_restring")
  archivedAt  DateTime?        @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(dbgenerated("app_now()")) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  variants    ProductVariant[]

  @@map("products")
}

model ProductVariant {
  id              String    @id @default(cuid())
  productId       String    @map("product_id")
  sku             String    @unique
  label           String
  price           Int
  onHand          Int       @default(0) @map("on_hand")
  reserved        Int       @default(0)
  reorderLevel    Int       @map("reorder_level")
  taxCategory     String    @map("tax_category")
  hsnSac          String    @map("hsn_sac")
  lowStockAlerted Boolean   @default(false) @map("low_stock_alerted")
  // Completion pass P2: printed barcode (EAN/UPC) for scanning at the till; the SKU also scans.
  barcode         String?   @unique
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(dbgenerated("app_now()")) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  product         Product   @relation(fields: [productId], references: [id])

  @@map("product_variants")
}

model StockMovement {
  id               String      @id @default(cuid())
  variantId        String      @map("variant_id")
  qtyOnHandDelta   Int         @map("qty_on_hand_delta")
  qtyReservedDelta Int         @map("qty_reserved_delta")
  reason           StockReason
  refType          String?     @map("ref_type")
  refId            String?     @map("ref_id")
  unitCost         Int?        @map("unit_cost")
  note             String?
  actorId          String?     @map("actor_id")
  createdAt        DateTime    @default(dbgenerated("app_now()")) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([variantId])
  @@map("stock_movements")
}

model CounterSale {
  id        String   @id @default(cuid())
  code      String   @unique
  memberId  String?  @map("member_id")
  guestId   String?  @map("guest_id")
  billId    String   @unique @map("bill_id")
  soldBy    String   @map("sold_by")
  createdAt DateTime @default(dbgenerated("app_now()")) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("counter_sales")
}

model ShopOrder {
  id            String           @id @default(cuid())
  code          String           @unique
  memberId      String?          @map("member_id")
  guestId       String?          @map("guest_id")
  fulfilment    Fulfilment
  address       String?
  deliveryFee   Int              @default(0) @map("delivery_fee")
  paymentOption PaymentOption    @map("payment_option")
  status        OrderStatus
  holdExpiresAt DateTime?        @map("hold_expires_at") @db.Timestamptz(3)
  billId        String           @unique @map("bill_id")
  cancelReason  String?          @map("cancel_reason")
  trackToken    String           @unique @map("track_token")
  createdBy     String?          @map("created_by")
  createdAt     DateTime         @default(dbgenerated("app_now()")) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  lines         ShopOrderLine[]
  events        ShopOrderEvent[]

  @@map("shop_orders")
}

model ShopOrderLine {
  id        String    @id @default(cuid())
  orderId   String    @map("order_id")
  variantId String    @map("variant_id")
  qty       Int
  unitPrice Int       @map("unit_price")
  netAmount Int       @map("net_amount")
  createdAt DateTime  @default(dbgenerated("app_now()")) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  order     ShopOrder @relation(fields: [orderId], references: [id])

  @@map("shop_order_lines")
}

model ShopOrderEvent {
  id        String      @id @default(cuid())
  orderId   String      @map("order_id")
  status    OrderStatus
  note      String?
  actorId   String?     @map("actor_id")
  at        DateTime    @db.Timestamptz(3)
