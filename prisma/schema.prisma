// The Champions Club — data model (plan.md §6).
// Money columns are integer paise. Timestamps are timestamptz (UTC); business dates (@db.Date) are IST calendar dates.
// Constraints Prisma cannot express (exclusion constraints, partial unique indexes, CHECKs, append-only triggers,
// generated tstzrange columns) live in prisma/migrations/0002_constraints/migration.sql.
// Columns that exist only in raw SQL: court_reservations.period, shifts.period (generated tstzrange, BK-1 / ST-2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── enums ─────────────────────────────

